# Thryve Backend Environment Variables
# Copy this file to .env and fill in your keys. NEVER commit .env to git.

# Groq API key (for Abstractive AI summarization — primary engine)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace token (optional fallback for abstractive mode — BART-large-CNN)
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Server config (optional)
FLASK_DEBUG=false
PORT=5000
